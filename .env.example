# 复制为 .env 后填写（.env 已在 .gitignore 中，不会提交到仓库）
#   cp .env.example .env
# 任意 OpenAI 兼容接口均可（DeepSeek / 通义千问 / GLM / 自建 vLLM 等），需支持 Function Calling。

MINI_MODEL=openai_compatible
MINI_BASE_URL=
MINI_API_KEY=
MINI_MODEL_NAME=

# 示例：
#   DeepSeek   MINI_BASE_URL=https://api.deepseek.com                              MINI_MODEL_NAME=deepseek-chat
#   通义千问   MINI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1     MINI_MODEL_NAME=qwen-plus
#   GLM        MINI_BASE_URL=https://open.bigmodel.cn/api/paas/v4                  MINI_MODEL_NAME=glm-4-plus
# 模型名以服务商控制台当前提供的为准。

# 改回离线 Mock 模型：MINI_MODEL=mock（或删掉本文件）
